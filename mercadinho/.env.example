# ------------------------------------------------------------------
# Mercadinho do Seu Joao - variaveis de ambiente
# Copie este arquivo para .env e ajuste os valores.
# ------------------------------------------------------------------

# Chave usada para assinar a sessao de login. Troque em producao.
SECRET_KEY=troque-esta-chave-em-producao

# Banco de dados PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mercadinho
# Banco usado apenas pelos testes automatizados
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mercadinho_test

# Quantos dias antes do vencimento o sistema avisa (cliente pediu 3)
DIAS_AVISO_VALIDADE=3
# Quantos dias um perecivel pode ficar parado antes de virar risco de perda
DIAS_PERECIVEL_PARADO=2
# Quantos dias de venda a lista de compras tenta cobrir
DIAS_COBERTURA_COMPRA=3

# Alertas por Telegram (opcional). Sem token, o alerta fica so dentro do sistema.
TELEGRAM_BOT_TOKEN=
# Manda copia dos alertas para os administradores (dono e esposa)
ALERTA_COPIA_ADMIN=true

# Usuario administrador criado pelo comando "flask criar-admin"
ADMIN_LOGIN=joao
ADMIN_SENHA=trocar123
ADMIN_NOME=Seu Joao
